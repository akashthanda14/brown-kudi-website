{
  "name": "brownn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:optimized": "vite build && npm run compress",
    "compress": "find dist -type f \\( -name \"*.js\" -o -name \"*.css\" \\) | xargs -I{} sh -c 'gzip -k -9 \"$1\" && brotli -Z \"$1\"' --",
    "analyze": "vite build --mode analyze && npx rollup-plugin-visualizer dist/stats.html --open",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1",
    "aos": "^2.3.4",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "locomotive-scroll": "^4.1.4",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-router-dom": "^7.8.2",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.2.10",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "vite": "^7.1.2",
    "vite-plugin-imagemin": "^0.6.1"
  }
}
